# Copia este archivo a ".env" y ajusta los valores según tu entorno.
# Todas las variables usan el prefijo BIOGUARD_.

BIOGUARD_APP_VERSION=0.1.0
BIOGUARD_DEBUG=true

# Umbral de negocio: probabilidad >= este valor = estado crítico.
BIOGUARD_UMBRAL_CRITICO=0.85

# Predictor activo:
#   "baseline" -> v0 que reacciona a las señales vitales (severidad por desviación de rangos).
#   "mock"     -> devuelve siempre BIOGUARD_PROBABILIDAD_MOCK (solo para probar comunicación).
BIOGUARD_PREDICTOR_ACTIVO=baseline

# Identificador del "modelo" activo (el baseline usa "baseline-v0").
BIOGUARD_MODELO_ACTIVO=baseline-v0

# Peso (0 a 1) que se le da a la PEOR señal frente a la media ponderada
# al combinar el riesgo. 1.0 = manda solo la peor señal; 0.0 = solo la media.
BIOGUARD_BASELINE_PESO_PEOR_SENAL=0.6

# Probabilidad fija que devuelve el predictor "mock" (solo si BIOGUARD_PREDICTOR_ACTIVO=mock).
BIOGUARD_PROBABILIDAD_MOCK=0.90

# Origenes permitidos por CORS (para desarrollo web). "*" permite todos.
BIOGUARD_CORS_ORIGINS=["*"]
